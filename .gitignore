# Real configs hold hostnames, account ids, profile names and users.
# Only jenkins_cli/config.example.yaml is tracked.
config.yaml
config.*.yaml
!jenkins_cli/config.example.yaml
*.local.yaml
*.bak
*.bak-*

# Secrets - never commit
.env
.env.*
*.pem
*.key
*.token

# Local notes and tooling, not shipped to the repo
CLAUDE.md
CLAUDE.local.md
.claude/
.vscode/
.idea/
*.swp

# Fetched builds hold real job data (in case anyone fetches into the repo)
investigations/
jenkins-investigations/
params.json
config.xml
pipeline.groovy
*.log

# Python
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# macOS
.DS_Store
